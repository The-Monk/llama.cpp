# RETIRED 2026-08-15 — do not source this for new work. Use use-rocm714.env.
#
# This file pinned inference to TheRock ROCm 7.13 (JM directive 2026-07-16,
# accepting a 3-5% loss versus 7.2.4 to escape /opt/rocm-7.2.4 entirely). That
# directive is rescinded: ROCm 7.14 is the going-forward toolchain. There is no
# 7.15 — TheRock's nightly index has published nothing since 7.14.0a20260612.
#
# The pin was already dead in practice before it was retired on paper: at the
# time of retirement NOTHING in either repo sourced this file. Every live
# consumer (scripts/auto-batch-serve.sh, ROC8-PROMOTION-VERIFY.md, the roc9/roc10
# trees, the promotion gate's primary toolchain) had already moved to 7.14. The
# only surviving reference to the name was a comment in use-rocm714.env.
#
# WHY THE FILE STAYS: the frozen submission image
# (ghcr.io/the-monk/the-rock8:rdna4-tr713, built from roc8 70629174b1) bundles
# the 7.13 runtime, and container/Containerfile still COPYs therock/ from a
# 7.13.0 tree. That artifact is frozen and must stay reproducible, so the 7.13
# recipe cannot be deleted -- only demoted. Reproducing or debugging the shipped
# image is the ONE remaining legitimate reason to source this.
#
# Successor for images: container/Containerfile.dev714 (7.14 devel SDK).
# NOTE: as of 2026-08-15 that recipe has never been built -- every image on this
# box is a tr713 tag -- and it builds branch roc8, which carries the MUL_MAT_ID
# OOB defect. It is not yet a validated replacement. Do not describe it as one
# until it has been built from a fixed branch and passed validate_image.sh.
#
# Toolchain status on this box:
#   7.2.4  /opt/rocm-7.2.4        system, superseded, still on disk
#   7.13   /opt/therock-7.13.0    RETIRED (this file) -- frozen-image repro only
#   7.14   qat714 _rocm_sdk_devel CURRENT -- see use-rocm714.env
export ROCM_LLAMACPP_ROOT=/opt/therock-7.13.0
export LD_LIBRARY_PATH="/opt/therock-7.13.0/lib:/opt/therock-7.13.0/lib/llvm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LLAMA_BUILD_DIR=/home/jmonk/src/mainline-llama.cpp-mxfp8/build-tr713-real
echo "WARNING: use-rocm713.env is RETIRED (2026-08-15). Use use-rocm714.env unless you are reproducing the frozen tr713 image." >&2
