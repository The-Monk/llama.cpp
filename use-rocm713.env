# Source this (or prefix commands) to run llama.cpp binaries on TheRock ROCm 7.13
# instead of the system /opt/rocm-7.2.4. WITHOUT this, build-tr713-real SILENTLY
# falls back to 7.2.4 via the ldconfig cache (verified 2026-07-16). JM directive: keep inference on 7.13.
export ROCM_LLAMACPP_ROOT=/opt/therock-7.13.0
export LD_LIBRARY_PATH="/opt/therock-7.13.0/lib:/opt/therock-7.13.0/lib/llvm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LLAMA_BUILD_DIR=/home/jmonk/src/mainline-llama.cpp-mxfp8/build-tr713-real
