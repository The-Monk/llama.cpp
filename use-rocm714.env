# Force the ROCm 7.14 (pip rocm-sdk) runtime libs. Without this, ldconfig
# silently resolves libamdhip64/rocblas to /opt/rocm-7.2.4 and you are NOT
# running 7.14. Mirrors use-rocm713.env.
export LD_LIBRARY_PATH="/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_core/lib:/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_devel/lib:${LD_LIBRARY_PATH:-}"
export ROCM_PATH="/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_devel"
