# CURRENT toolchain (as of 2026-08-15). Force the ROCm 7.14 (pip rocm-sdk)
# runtime libs. Without this, ldconfig silently resolves libamdhip64/rocblas to
# /opt/rocm-7.2.4 and you are NOT running 7.14.
#
# Supersedes use-rocm713.env, which is RETIRED -- the "keep inference on 7.13"
# directive is rescinded. 7.14 is also the PRIMARY toolchain in the promotion
# gate (scripts/verify-roc8-promotion.sh); 7.13 is still compiled there second,
# solely because the frozen submission image shipped it.
#
# There is no ROCm 7.15: TheRock's gfx120X nightly index has published nothing
# newer than 7.14.0a20260612 (installed here: 7.14.0a20260611). If that index
# starts moving again, re-check before assuming 7.14 is still current.
export LD_LIBRARY_PATH="/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_core/lib:/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_devel/lib:${LD_LIBRARY_PATH:-}"
export ROCM_PATH="/home/jmonk/miniconda3/envs/qat714/lib/python3.12/site-packages/_rocm_sdk_devel"
